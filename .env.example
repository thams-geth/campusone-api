# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Matches docker-compose.yml's postgres service by default.
DATABASE_URL="postgresql://campusone:campusone_dev_password@localhost:5432/campusone?schema=public"

# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Origin(s) the frontend is served from, for CORS. Comma-separated for multiple.
CORS_ORIGIN="http://localhost:5173"
