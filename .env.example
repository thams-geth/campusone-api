# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Owns the tables and runs migrations. This is a Postgres SUPERUSER (the
# official postgres image makes POSTGRES_USER one) — used only by the
# Prisma CLI (prisma.config.ts), never by the running API. Superusers
# bypass Row-Level Security entirely, by design, regardless of FORCE
# ROW LEVEL SECURITY — which is exactly why the API must NOT connect
# with this one.
DATABASE_URL="postgresql://campusone:campusone_dev_password@localhost:5432/campusone?schema=public"

# The running API connects as this instead: a plain, non-superuser role
# (see docker/init-app-role.sql, applied automatically by docker-compose
# on a fresh database) so RLS policies actually apply to it.
APP_DATABASE_URL="postgresql://campusone_app:campusone_app_dev_password@localhost:5432/campusone?schema=public"

# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Origin(s) the frontend is served from, for CORS. Comma-separated for multiple.
CORS_ORIGIN="http://localhost:5173"

# Backs the notification reminder job queue (BullMQ) — matches
# docker-compose.yml's redis service by default.
REDIS_URL="redis://localhost:6379"
