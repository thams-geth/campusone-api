generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Every permission check is "does user X have role Y inside tenant Z" —
// never just "does this user have role Y." PLATFORM_ADMIN is the only
// role that isn't scoped to a single tenant.
enum Role {
  PLATFORM_ADMIN
  SUPER_ADMIN
  COLLEGE_ADMIN
  DEPARTMENT_ADMIN
  FACULTY
  STAFF
  STUDENT
}

enum ModuleId {
  CORE
  ACADEMICS
  ADMISSIONS
  FINANCE
  EXAMINATION
  HR_PAYROLL
  LIBRARY
  HOSTEL_TRANSPORT
  PLACEMENT_ALUMNI
  COMMUNICATION
  COMPLIANCE_REPORTING
  INVENTORY_PROCUREMENT
}

enum PlanTier {
  BASIC
  STANDARD
  ENTERPRISE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  ALUMNI
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  primaryColor String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  modules       TenantModule[]
  users         User[]
  departments   Department[]
  students      Student[]
  activityLogs  ActivityLog[]
  refreshTokens RefreshToken[]
}

// tenant_modules: which modules a tenant has installed/enabled, and at
// what plan tier. Core is implied always-on by application logic, not
// stored here.
model TenantModule {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleId  ModuleId
  enabled   Boolean  @default(false)
  planTier  PlanTier @default(BASIC)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, moduleId])
}

// Email is globally unique (not per-tenant) so a single login form can
// resolve the tenant from the email alone, without asking the user to
// pick a college first.
model User {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  email               String    @unique
  passwordHash        String
  role                Role
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  refreshTokens RefreshToken[]
  activityLogs  ActivityLog[]

  @@index([tenantId])
}

// Refresh tokens are stored hashed (never the raw token) so a DB leak
// alone doesn't let an attacker mint sessions.
model RefreshToken {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
}

model Department {
  id               String           @id @default(cuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  code             String
  headOfDepartment String?
  description      String?
  status           DepartmentStatus @default(ACTIVE)
  // No Faculty entity exists yet (out of V1 scope) — stored directly
  // for now instead of a relation count, matching the frontend's mock
  // contract. Revisit once a Faculty module exists.
  facultyCount     Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  students Student[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Student {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  email         String
  phone         String
  rollNumber    String
  departmentId  String
  department    Department    @relation(fields: [departmentId], references: [id])
  gender        Gender
  dateOfBirth   DateTime
  admissionDate DateTime
  status        StudentStatus @default(ACTIVE)
  guardianName  String?
  guardianPhone String?
  address       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([tenantId, email])
  @@unique([tenantId, rollNumber])
  @@index([tenantId])
  @@index([departmentId])
}

// Backs the dashboard's recent-activity feed. Written to by mutations
// in other modules (department/student create/update/delete).
model ActivityLog {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName   String
  message     String
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}
