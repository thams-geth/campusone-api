generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ModuleId {
  CORE
  ACADEMICS
  ADMISSIONS
  FINANCE
  EXAMINATION
  HR_PAYROLL
  LIBRARY
  HOSTEL_TRANSPORT
  PLACEMENT_ALUMNI
  COMMUNICATION
  COMPLIANCE_REPORTING
  INVENTORY_PROCUREMENT
}

enum PlanTier {
  BASIC
  STANDARD
  ENTERPRISE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  ALUMNI
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AcademicYearStatus {
  ACTIVE
  CLOSED
}

enum ProgramStatus {
  ACTIVE
  INACTIVE
}

enum BatchStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum SectionStatus {
  ACTIVE
  INACTIVE
}

enum SubjectType {
  CORE
  ELECTIVE
  LAB
  PROJECT
  SEMINAR
  PRACTICAL
}

enum FacultyStatus {
  ACTIVE
  INACTIVE
}

enum RoomStatus {
  ACTIVE
  INACTIVE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceSessionStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  ON_LEAVE
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  EVALUATED
}

enum ExamType {
  INTERNAL
  MIDTERM
  FINAL
  SUPPLEMENTARY
}

enum ExamStatus {
  SCHEDULED
  ONGOING
  COMPLETED
}

enum MarksStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  PUBLISHED
}

enum MarksSpecialStatus {
  ABSENT
  MALPRACTICE
  WITHHELD
}

enum AnnouncementAudience {
  COLLEGE
  DEPARTMENT
  PROGRAM
  BATCH
  SECTION
}

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
}

enum DocumentOwnerType {
  STUDENT
  FACULTY
  APPLICANT
}

enum DocumentType {
  BONAFIDE
  TRANSFER_CERTIFICATE
  CONDUCT_CERTIFICATE
  MARK_SHEET
  ID_PROOF
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  primaryColor String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  modules               TenantModule[]
  users                 User[]
  roles                 Role[]
  userRoles             UserRole[]
  departments           Department[]
  academicYears         AcademicYear[]
  programs              Program[]
  batches               Batch[]
  sections              Section[]
  subjects              Subject[]
  faculty               Faculty[]
  rooms                 Room[]
  timetableEntries      TimetableEntry[]
  students              Student[]
  auditLogs             AuditLog[]
  refreshTokens         RefreshToken[]
  attendanceSessions    AttendanceSession[]
  attendanceRecords     AttendanceRecord[]
  attendanceCorrections AttendanceCorrection[]
  leaveTypes            LeaveType[]
  leaveRequests         LeaveRequest[]
  assignments           Assignment[]
  assignmentSubmissions AssignmentSubmission[]
  exams                 Exam[]
  examSchedules         ExamSchedule[]
  marks                 Marks[]
  announcements         Announcement[]
  documents             Document[]
  admissionApplications AdmissionApplication[]
  feeStructures         FeeStructure[]
  feeInvoices           FeeInvoice[]
  feeAdjustments        FeeAdjustment[]
  payments              Payment[]
  hostels               Hostel[]
  hostelRooms           HostelRoom[]
  hostelAllocations     HostelAllocation[]
  vehicles              Vehicle[]
  routes                Route[]
  stops                 Stop[]
  studentTransports     StudentTransport[]
  books                 Book[]
  bookIssues            BookIssue[]
  certificateTypes      CertificateType[]
  certificateRequests   CertificateRequest[]
  studentActivities     StudentActivity[]
  companies             Company[]
  jobOpenings           JobOpening[]
  placementApplications PlacementApplication[]
  subscription          Subscription?
  billingInvoices       BillingInvoice[]
  mfaRecoveryCodes      MfaRecoveryCode[]
  loginHistory          LoginHistory[]
  apiKeys               ApiKey[]
  webhookEndpoints      WebhookEndpoint[]
  webhookDeliveries     WebhookDelivery[]
  integrationConfigs    IntegrationConfig[]
  approvalRequests      ApprovalRequest[]
}

// tenant_modules: which modules a tenant has installed/enabled, and at
// what plan tier. Core is implied always-on by application logic, not
// stored here.
model TenantModule {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleId  ModuleId
  enabled   Boolean  @default(false)
  planTier  PlanTier @default(BASIC)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, moduleId])
}

// Dynamic RBAC (roadmap #23 — "do not hardcode all permissions around
// roles"). tenantId is nullable ONLY for the single cross-tenant
// PLATFORM_ADMIN role; every other role is seeded per-tenant (see
// src/modules/rbac/rbac.seed.ts) so a tenant could eventually define
// custom roles without touching other tenants' data.
model Role {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isSystem  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Global reference data (not tenant-scoped) — the fixed catalogue of
// grantable capabilities, e.g. "STUDENT_READ". No RLS: not sensitive,
// and every route that reads it is already behind requireAuth.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  tenantId     String?
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([tenantId])
  @@index([roleId])
}

// Join table so a user can hold more than one role later; today every
// user is seeded with exactly one row here at creation time.
model UserRole {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([tenantId])
  @@index([userId])
}

// Email is globally unique (not per-tenant) so a single login form can
// resolve the tenant from the email alone, without asking the user to
// pick a college first.
model User {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  email               String    @unique
  passwordHash        String
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // TOTP secret — plaintext, not hashed: verification needs to
  // recompute the HMAC, which a one-way hash can't support. A real
  // limitation for now (production would encrypt at rest via a KMS);
  // protected today by tenant RLS + auth same as everything else.
  mfaSecret           String?
  mfaEnabled          Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  roles          UserRole[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  facultyProfile Faculty?
  studentProfile Student?

  attendanceCorrectionsRequested AttendanceCorrection[] @relation("AttendanceCorrectionRequestedBy")
  attendanceCorrectionsReviewed  AttendanceCorrection[] @relation("AttendanceCorrectionReviewedBy")
  leaveRequestsReviewed          LeaveRequest[]         @relation("LeaveRequestReviewedBy")
  assignmentSubmissionsEvaluated AssignmentSubmission[] @relation("AssignmentSubmissionEvaluatedBy")
  marksEntered                   Marks[]                @relation("MarksEnteredBy")
  marksVerified                  Marks[]                @relation("MarksVerifiedBy")
  marksPublished                 Marks[]                @relation("MarksPublishedBy")
  announcementsAuthored          Announcement[]         @relation("AnnouncementAuthor")
  documentsUploaded              Document[]             @relation("DocumentUploadedBy")
  documentsVerified              Document[]             @relation("DocumentVerifiedBy")
  admissionsReviewed             AdmissionApplication[] @relation("AdmissionReviewedBy")
  feeAdjustmentsCreated          FeeAdjustment[]        @relation("FeeAdjustmentCreatedBy")
  paymentsRecorded               Payment[]              @relation("PaymentRecordedBy")
  certificatesIssued             CertificateRequest[]   @relation("CertificateIssuedBy")
  mfaRecoveryCodes               MfaRecoveryCode[]
  loginHistory                   LoginHistory[]
  apiKeysCreated                 ApiKey[]
  approvalRequestsMade           ApprovalRequest[]      @relation("ApprovalRequestedBy")
  approvalRequestsDecided        ApprovalRequest[]      @relation("ApprovalDecidedBy")

  @@index([tenantId])
}

// Refresh tokens are stored hashed (never the raw token) so a DB leak
// alone doesn't let an attacker mint sessions.
model RefreshToken {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
}

model Department {
  id               String           @id @default(cuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  code             String
  headOfDepartment String?
  description      String?
  status           DepartmentStatus @default(ACTIVE)
  // No Faculty entity existed at first (out of V1 scope) — stored
  // directly for now instead of a relation count, matching the
  // frontend's mock contract. Faculty now exists (see below); this
  // stays as a manual override field until the dashboard/department
  // list switches to a live faculty count.
  facultyCount     Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  students Student[]
  programs Program[]
  faculty  Faculty[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model AcademicYear {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean            @default(false)
  status    AcademicYearStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  batches       Batch[]
  exams         Exam[]
  feeStructures FeeStructure[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Program {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departmentId  String
  department    Department    @relation(fields: [departmentId], references: [id])
  name          String
  code          String
  durationYears Int
  status        ProgramStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  batches               Batch[]
  subjects              Subject[]
  admissionApplications AdmissionApplication[]
  feeStructures         FeeStructure[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([departmentId])
}

model Batch {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programId      String
  program        Program      @relation(fields: [programId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String
  startYear      Int
  endYear        Int
  status         BatchStatus  @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sections Section[]

  @@unique([tenantId, programId, name])
  @@index([tenantId])
  @@index([programId])
  @@index([academicYearId])
}

model Section {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batchId         String
  batch           Batch         @relation(fields: [batchId], references: [id])
  name            String
  currentSemester Int
  capacity        Int?
  status          SectionStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  students           Student[]
  timetableEntries   TimetableEntry[]
  attendanceSessions AttendanceSession[]
  assignments        Assignment[]

  @@unique([tenantId, batchId, name])
  @@index([tenantId])
  @@index([batchId])
}

model Subject {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programId      String
  program        Program     @relation(fields: [programId], references: [id])
  semesterNumber Int
  code           String
  name           String
  credits        Int
  type           SubjectType @default(CORE)
  facultyId      String?
  faculty        Faculty?    @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  timetableEntries   TimetableEntry[]
  attendanceSessions AttendanceSession[]
  assignments        Assignment[]
  examSchedules      ExamSchedule[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([programId])
  @@index([facultyId])
}

// One-to-one with a User that holds role FACULTY — auth/identity stays
// on User, employment/academic profile lives here.
model Faculty {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode    String
  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id])
  designation     String
  qualification   String?
  experienceYears Int           @default(0)
  joiningDate     DateTime
  status          FacultyStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  subjects           Subject[]
  timetableEntries   TimetableEntry[]
  attendanceSessions AttendanceSession[]
  assignments        Assignment[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([departmentId])
}

// Deliberately flat — no Campus/Building/Floor hierarchy yet (out of
// this milestone's scope). Extend with a nullable buildingId later.
model Room {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  capacity  Int?
  status    RoomStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  timetableEntries TimetableEntry[]
  examSchedules    ExamSchedule[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// One row per (section, weekday, period) slot. Conflict detection
// (faculty/room/section double-booking) is enforced in
// timetable.service.ts, not by a DB constraint, since it depends on
// overlapping start/end times rather than exact equality.
model TimetableEntry {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id])
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  facultyId String
  faculty   Faculty  @relation(fields: [facultyId], references: [id])
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  dayOfWeek Weekday
  startTime String // "HH:mm", 24h — a plain time-of-day, not tied to a date
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([sectionId, dayOfWeek])
  @@index([facultyId, dayOfWeek])
  @@index([roomId, dayOfWeek])
}

model Student {
  id                     String                @id @default(cuid())
  tenantId               String
  tenant                 Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName              String
  lastName               String
  email                  String
  phone                  String
  rollNumber             String
  departmentId           String
  department             Department            @relation(fields: [departmentId], references: [id])
  sectionId              String?
  section                Section?              @relation(fields: [sectionId], references: [id])
  currentSemester        Int?
  // Nullable, unlike Faculty's required userId: a Student row predates
  // any login account (created by admin data entry) and self-service
  // (leave requests, assignment submissions, viewing own marks) only
  // becomes possible once one is linked. No backfill for existing rows.
  userId                 String?               @unique
  user                   User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Set only when this Student was created by enrolling an
  // AdmissionApplication (see admissions.service.ts) — most students
  // are still created directly by admin data entry and have none.
  admissionApplicationId String?               @unique
  admissionApplication   AdmissionApplication? @relation(fields: [admissionApplicationId], references: [id])
  gender                 Gender
  dateOfBirth            DateTime
  admissionDate          DateTime
  status                 StudentStatus         @default(ACTIVE)
  guardianName           String?
  guardianPhone          String?
  address                String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  attendanceRecords     AttendanceRecord[]
  leaveRequests         LeaveRequest[]
  assignmentSubmissions AssignmentSubmission[]
  marks                 Marks[]
  feeInvoices           FeeInvoice[]
  hostelAllocations     HostelAllocation[]
  studentTransports     StudentTransport[]
  certificateRequests   CertificateRequest[]
  studentActivities     StudentActivity[]
  placementApplications PlacementApplication[]

  @@unique([tenantId, email])
  @@unique([tenantId, rollNumber])
  @@index([tenantId])
  @@index([departmentId])
  @@index([sectionId])
}

// Structured audit trail (roadmap #25), generalized from the earlier
// ActivityLog. `message` alone still backs the dashboard's
// recent-activity feed (see src/modules/shared/activityLog.ts); the
// rest is populated by the audit module's own writer for anything that
// needs the full before/after record.
model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName   String
  message     String
  entity      String?
  entityId    String?
  action      String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
}

// Attendance (roadmap #7) — one session per (section, subject, date).
// DRAFT -> SUBMITTED -> LOCKED; once LOCKED, records can't be edited
// directly, only through AttendanceCorrection's approve/reject flow —
// the roadmap's own flagship "not just CRUD" example (#45).
model AttendanceSession {
  id        String                  @id @default(cuid())
  tenantId  String
  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section                 @relation(fields: [sectionId], references: [id])
  subjectId String
  subject   Subject                 @relation(fields: [subjectId], references: [id])
  facultyId String
  faculty   Faculty                 @relation(fields: [facultyId], references: [id])
  date      DateTime
  status    AttendanceSessionStatus @default(DRAFT)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  records AttendanceRecord[]

  @@unique([tenantId, sectionId, subjectId, date])
  @@index([tenantId])
  @@index([sectionId, date])
  @@index([facultyId, date])
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student           @relation(fields: [studentId], references: [id])
  status    AttendanceStatus  @default(PRESENT)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  corrections AttendanceCorrection[]

  @@unique([sessionId, studentId])
  @@index([tenantId])
  @@index([studentId])
}

model AttendanceCorrection {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordId          String
  record            AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  requestedStatus   AttendanceStatus
  reason            String
  status            CorrectionStatus @default(PENDING)
  requestedByUserId String
  requestedBy       User             @relation("AttendanceCorrectionRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedByUserId  String?
  reviewedBy        User?            @relation("AttendanceCorrectionReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt        DateTime?
  createdAt         DateTime         @default(now())

  @@index([tenantId])
  @@index([recordId])
}

// Leave (roadmap #16) — "leave and attendance should be integrated":
// approving a request updates any existing AttendanceRecord rows for
// that student in the date range to ON_LEAVE. Balance is computed on
// read (approved days per type per year), not a stored ledger.
model LeaveType {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  defaultDaysPerYear Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  requests LeaveRequest[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model LeaveRequest {
  id               String             @id @default(cuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student            @relation(fields: [studentId], references: [id])
  leaveTypeId      String
  leaveType        LeaveType          @relation(fields: [leaveTypeId], references: [id])
  startDate        DateTime
  endDate          DateTime
  reason           String
  status           LeaveRequestStatus @default(PENDING)
  reviewedByUserId String?
  reviewedBy       User?              @relation("LeaveRequestReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([tenantId])
  @@index([studentId])
}

// Assignments (roadmap #8). attachmentUrl is a client-supplied
// reference, not an uploaded file — no object storage wired up yet.
model Assignment {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject          @relation(fields: [subjectId], references: [id])
  facultyId   String
  faculty     Faculty          @relation(fields: [facultyId], references: [id])
  sectionId   String
  section     Section          @relation(fields: [sectionId], references: [id])
  title       String
  description String?
  startDate   DateTime
  dueDate     DateTime
  maxMarks    Int
  status      AssignmentStatus @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  submissions AssignmentSubmission[]

  @@index([tenantId])
  @@index([sectionId])
  @@index([subjectId])
}

model AssignmentSubmission {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignmentId      String
  assignment        Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student          @relation(fields: [studentId], references: [id])
  submittedAt       DateTime         @default(now())
  attachmentUrl     String?
  status            SubmissionStatus @default(SUBMITTED)
  marksObtained     Int?
  feedback          String?
  evaluatedByUserId String?
  evaluatedBy       User?            @relation("AssignmentSubmissionEvaluatedBy", fields: [evaluatedByUserId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([assignmentId, studentId])
  @@index([tenantId])
  @@index([studentId])
}

// Examinations (roadmap #9). No separate ExamRoom/ExamInvigilator/
// ExamRegistration (a single roomId; registration is implicit — any
// student in the section is eligible) and no Revaluation/
// SupplementaryExam entities (folded into Marks.specialStatus) —
// reasonable simplifications with no CBCS/elective registration yet.
model Exam {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  examType       ExamType
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  semesterNumber Int
  startDate      DateTime
  endDate        DateTime
  status         ExamStatus   @default(SCHEDULED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  schedules ExamSchedule[]

  @@index([tenantId])
  @@index([academicYearId])
}

model ExamSchedule {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  examDate  DateTime
  startTime String
  endTime   String
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marks Marks[]

  @@unique([examId, subjectId])
  @@index([tenantId])
  @@index([roomId, examDate])
}

// Once PUBLISHED, direct edits stop — see MARKS_REVISE in
// src/modules/rbac/permissions.ts, which requires a before/after audit
// record (roadmap: "published marks changes require authorization and
// an audit record"). Grade letters/SGPA/CGPA are computed on read in
// examinations.service.ts, not stored, to avoid a second source of
// truth that can drift from the underlying marks.
model Marks {
  id                String              @id @default(cuid())
  tenantId          String
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  examScheduleId    String
  examSchedule      ExamSchedule        @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student             @relation(fields: [studentId], references: [id])
  marksObtained     Int?
  maxMarks          Int
  status            MarksStatus         @default(DRAFT)
  specialStatus     MarksSpecialStatus?
  enteredByUserId   String?
  enteredBy         User?               @relation("MarksEnteredBy", fields: [enteredByUserId], references: [id])
  verifiedByUserId  String?
  verifiedBy        User?               @relation("MarksVerifiedBy", fields: [verifiedByUserId], references: [id])
  publishedByUserId String?
  publishedBy       User?               @relation("MarksPublishedBy", fields: [publishedByUserId], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([examScheduleId, studentId])
  @@index([tenantId])
  @@index([studentId])
}

// Announcements (roadmap #12) — in-app only, no SMS/WhatsApp/email/push
// delivery yet (rest of the COMMUNICATION module, deferred same as
// Notifications was in Milestone 1).
model Announcement {
  id           String               @id @default(cuid())
  tenantId     String
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  content      String
  authorUserId String
  author       User                 @relation("AnnouncementAuthor", fields: [authorUserId], references: [id])
  audience     AnnouncementAudience
  departmentId String?
  programId    String?
  batchId      String?
  sectionId    String?
  priority     AnnouncementPriority @default(MEDIUM)
  publishAt    DateTime             @default(now())
  expiryAt     DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([tenantId])
  @@index([tenantId, publishAt])
}

// Documents (roadmap #15) — generic document metadata; fileUrl is a
// reference to wherever the file actually lives, not an uploaded file
// (no object storage wired up yet, same reasoning as Assignments).
model Document {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerType        DocumentOwnerType
  ownerId          String
  type             DocumentType
  fileUrl          String
  version          Int               @default(1)
  uploadedByUserId String
  uploadedBy       User              @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])
  verifiedByUserId String?
  verifiedBy       User?             @relation("DocumentVerifiedBy", fields: [verifiedByUserId], references: [id])
  status           DocumentStatus    @default(PENDING)
  expiryDate       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([tenantId])
  @@index([tenantId, ownerType, ownerId])
}

// ---- Milestone 3: College Operations (roadmap Release 3) ----

enum AdmissionStatus {
  APPLIED
  DOCUMENT_VERIFICATION
  SHORTLISTED
  APPROVED
  OFFERED
  ACCEPTED
  ENROLLED
  REJECTED
  WITHDRAWN
}

enum FeeCategory {
  TUITION
  HOSTEL
  TRANSPORT
  EXAM
  LIBRARY
  LAB
  OTHER
}

enum FeeInvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

enum FeeAdjustmentType {
  DISCOUNT
  SCHOLARSHIP
  FINE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  CHEQUE
  OTHER
}

enum AllocationStatus {
  ACTIVE
  INACTIVE
}

enum PersonType {
  STUDENT
  FACULTY
}

enum CertificateRequestStatus {
  REQUESTED
  ISSUED
  REJECTED
}

enum ActivityType {
  ACHIEVEMENT
  EVENT
  CLUB
  SPORTS
  COMPETITION
  INTERNSHIP
  OTHER
}

enum PlacementApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
}

// Applicant fields live directly on the application — nothing about an
// applicant exists before they apply, so no separate Applicant entity
// (unlike Student, which persists independently of how it was
// created). Enrolling creates the real Student row via the existing
// createStudent path and links back via Student.admissionApplicationId.
model AdmissionApplication {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  email            String
  phone            String
  dateOfBirth      DateTime
  programId        String
  program          Program         @relation(fields: [programId], references: [id])
  status           AdmissionStatus @default(APPLIED)
  reviewedByUserId String?
  reviewedBy       User?           @relation("AdmissionReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewNotes      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  student Student?

  @@unique([tenantId, email, programId])
  @@index([tenantId])
  @@index([programId])
}

// Fees & Finance (roadmap #11) — an internal ledger, not a live payment
// gateway (Razorpay/Cashfree need real credentials this environment
// doesn't have; wiring one is a later, focused pass). Invoice status is
// recomputed from payments/adjustments on every write, never trusted
// as stored truth on its own — same "don't maintain a second source of
// truth" reasoning as Examinations' SGPA/CGPA.
model FeeStructure {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programId      String
  program        Program      @relation(fields: [programId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  category       FeeCategory
  amount         Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  invoices FeeInvoice[]

  @@unique([tenantId, programId, academicYearId, category])
  @@index([tenantId])
  @@index([programId])
}

model FeeInvoice {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id])
  feeStructureId String?
  feeStructure   FeeStructure?    @relation(fields: [feeStructureId], references: [id])
  category       FeeCategory
  amount         Int
  dueDate        DateTime
  status         FeeInvoiceStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  adjustments FeeAdjustment[]
  payments    Payment[]

  @@index([tenantId])
  @@index([studentId])
}

model FeeAdjustment {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         FeeInvoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type            FeeAdjustmentType
  amount          Int
  reason          String
  createdByUserId String
  createdBy       User              @relation("FeeAdjustmentCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime          @default(now())

  @@index([tenantId])
  @@index([invoiceId])
}

// isRefund + a self-relation instead of a separate Refund table — a
// refund IS a payment, just negative-direction and tied back to the
// original.
model Payment {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId         String
  invoice           FeeInvoice    @relation(fields: [invoiceId], references: [id])
  amount            Int
  method            PaymentMethod
  isRefund          Boolean       @default(false)
  originalPaymentId String?
  originalPayment   Payment?      @relation("PaymentRefund", fields: [originalPaymentId], references: [id])
  refunds           Payment[]     @relation("PaymentRefund")
  transactionRef    String?
  recordedByUserId  String
  recordedBy        User          @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id])
  createdAt         DateTime      @default(now())

  @@index([tenantId])
  @@index([invoiceId])
}

// Hostel (roadmap #19) — deliberately flat, no Building/Floor (same
// simplification as the academic Room model), no separate Bed table
// (bedNumber is a plain field, capacity checked in the service layer).
model Hostel {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms HostelRoom[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model HostelRoom {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostelId   String
  hostel     Hostel   @relation(fields: [hostelId], references: [id])
  roomNumber String
  capacity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  allocations HostelAllocation[]

  @@unique([tenantId, hostelId, roomNumber])
  @@index([tenantId])
  @@index([hostelId])
}

model HostelAllocation {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id])
  hostelRoomId String
  hostelRoom   HostelRoom       @relation(fields: [hostelRoomId], references: [id])
  bedNumber    Int
  status       AllocationStatus @default(ACTIVE)
  startDate    DateTime
  endDate      DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([tenantId])
  @@index([studentId])
  @@index([hostelRoomId])
}

// Transport (roadmap #20) — driver name/phone are plain fields on
// Vehicle rather than a separate Driver entity; no Trip/FacultyTransport.
model Vehicle {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrationNumber String
  driverName         String
  driverPhone        String
  capacity           Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  routes Route[]

  @@unique([tenantId, registrationNumber])
  @@index([tenantId])
}

model Route {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stops       Stop[]
  allocations StudentTransport[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Stop {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routeId   String
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name      String
  sequence  Int
  createdAt DateTime @default(now())

  allocations StudentTransport[]

  @@unique([tenantId, routeId, sequence])
  @@index([tenantId])
  @@index([routeId])
}

model StudentTransport {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  routeId   String
  route     Route            @relation(fields: [routeId], references: [id])
  stopId    String
  stop      Stop             @relation(fields: [stopId], references: [id])
  status    AllocationStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([tenantId])
  @@index([studentId])
}

// Library (roadmap #21) — author/publisher/category as plain fields
// (no separate normalized entities), availableCopies tracked directly
// on Book instead of per-copy rows. BookIssue's status (issued/
// returned/overdue) is derived from returnedAt/dueDate on read, not
// stored — one less place for it to drift.
model Book {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String
  author          String
  publisher       String?
  category        String?
  isbn            String?
  totalCopies     Int
  availableCopies Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  issues BookIssue[]

  @@index([tenantId])
}

model BookIssue {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookId     String
  book       Book       @relation(fields: [bookId], references: [id])
  ownerType  PersonType
  ownerId    String
  issuedAt   DateTime   @default(now())
  dueDate    DateTime
  returnedAt DateTime?
  fineAmount Int?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([tenantId])
  @@index([bookId])
  @@index([ownerType, ownerId])
}

// Certificates (roadmap #22) — the *issuance* workflow, distinct from
// Documents (arbitrary uploaded files). verificationCode stands in for
// "digital signature/QR": an actual QR is just that code rendered
// client-side, no PDF/QR generation library added here.
model CertificateType {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests CertificateRequest[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model CertificateRequest {
  id                String                   @id @default(cuid())
  tenantId          String
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student                  @relation(fields: [studentId], references: [id])
  certificateTypeId String
  certificateType   CertificateType          @relation(fields: [certificateTypeId], references: [id])
  status            CertificateRequestStatus @default(REQUESTED)
  issuedByUserId    String?
  issuedBy          User?                    @relation("CertificateIssuedBy", fields: [issuedByUserId], references: [id])
  issuedAt          DateTime?
  verificationCode  String?                  @unique
  rejectionReason   String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([tenantId])
  @@index([studentId])
}

// Student Activities (roadmap #17) — one lightweight record type
// covering achievements/events/clubs/sports/competitions/internships,
// self-reportable by the student or recorded by staff.
model StudentActivity {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  type           ActivityType
  title          String
  description    String?
  date           DateTime
  certificateUrl String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tenantId])
  @@index([studentId])
}

// Placements (roadmap #18) — no separate Interview/PlacementResult
// entities; both fold into the application's status progression and
// fields, same reasoning as Assignments not needing a separate
// grading-workflow entity. Eligibility is a simple minCgpa filter, not
// a formal EligibilityCriteria entity.
model Company {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobOpenings JobOpening[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model JobOpening {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id])
  title               String
  description         String?
  minCgpa             Float?
  ctcOffered          Int?
  applicationDeadline DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  applications PlacementApplication[]

  @@index([tenantId])
  @@index([companyId])
}

model PlacementApplication {
  id           String                     @id @default(cuid())
  tenantId     String
  tenant       Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student                    @relation(fields: [studentId], references: [id])
  jobOpeningId String
  jobOpening   JobOpening                 @relation(fields: [jobOpeningId], references: [id])
  status       PlacementApplicationStatus @default(APPLIED)
  notes        String?
  offeredCtc   Int?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@unique([studentId, jobOpeningId])
  @@index([tenantId])
  @@index([jobOpeningId])
}

// ---- Milestone 4: Enterprise SaaS (roadmap Release 4) ----

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingInvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

enum IntegrationProvider {
  PAYMENT_GATEWAY
  EMAIL
  SMS
  FIREBASE
  GOOGLE_WORKSPACE
  MICROSOFT_365
  BIOMETRIC_ATTENDANCE
  ACCOUNTING_SOFTWARE
  LMS
  LIBRARY_SYSTEM
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

// Billing (roadmap #32) — an internal ledger, not a live payment
// gateway, same reasoning as Fees. Self-service only: a tenant manages
// its own subscription; there's no cross-tenant PLATFORM_ADMIN console
// yet (Tenant has no RLS — see the init migration's comment on why
// that's deferred, not an oversight).
model Plan {
  id           String   @id @default(cuid())
  name         String   @unique
  studentLimit Int
  facultyLimit Int
  priceMonthly Int
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  invoices BillingInvoice[]
}

model BillingInvoice {
  id             String               @id @default(cuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription         @relation(fields: [subscriptionId], references: [id])
  amount         Int
  status         BillingInvoiceStatus @default(PENDING)
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([tenantId])
  @@index([subscriptionId])
}

// Auth hardening (roadmap #34). MfaRecoveryCode: one-time backup codes,
// hashed like refresh tokens. LoginHistory: only written for a
// resolved user (a failed attempt against an email that doesn't exist
// has no tenant to scope the row to — same reasoning as the login
// bootstrap exception on User).
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
}

model LoginHistory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId, createdAt])
}

// API Keys (roadmap #33) — a key authenticates AS its creating user
// (inherits their exact role/permissions) rather than carrying its own
// scope system. Looked up by hash before the tenant is known, same
// bootstrap problem as User email / RefreshToken hash lookups — see
// findApiKeyByHash in src/prisma/client.ts and this table's RLS policy.
model ApiKey {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  keyHash         String    @unique
  keyPrefix       String
  createdByUserId String
  createdBy       User      @relation(fields: [createdByUserId], references: [id])
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId])
}

// Webhooks (roadmap #33) — inline delivery (a single fetch at the
// moment an event fires), no retry queue yet; WebhookDelivery is what
// a future queue-backed retry would read from. URLs are tenant-
// supplied and get POSTed to by this server — a real SSRF vector, see
// src/utils/ssrfGuard.ts, checked at registration AND before every
// delivery attempt.
model WebhookEndpoint {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url        String
  secret     String
  eventTypes String[]
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([tenantId])
}

model WebhookDelivery {
  id                String                @id @default(cuid())
  tenantId          String
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookEndpointId String
  webhookEndpoint   WebhookEndpoint       @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)
  eventType         String
  payload           Json
  status            WebhookDeliveryStatus @default(PENDING)
  attempts          Int                   @default(0)
  responseStatus    Int?
  lastAttemptAt     DateTime?
  createdAt         DateTime              @default(now())

  @@index([tenantId])
  @@index([webhookEndpointId])
}

// Integrations (roadmap #33) — config only. Enabling one flips a flag
// and stores settings; no code path ever calls out to any of these
// providers. settings is plain JSON, not encrypted — a real
// limitation (production needs a KMS-backed secret store), documented
// rather than silently ignored.
model IntegrationConfig {
  id        String              @id @default(cuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider  IntegrationProvider
  enabled   Boolean             @default(false)
  settings  Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
}

// Minimal generic approval engine (roadmap #24) — deliberately NOT the
// full Workflow/WorkflowStep pair; no concrete multi-step chain exists
// anywhere yet to justify it. The six existing per-module approval
// flows (attendance corrections, marks revisions, leave, admissions,
// fee waivers, document verification) are untouched — this is for the
// NEXT new approval-shaped feature.
model ApprovalRequest {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type              String
  entity            String
  entityId          String
  requestedByUserId String
  requestedBy       User           @relation("ApprovalRequestedBy", fields: [requestedByUserId], references: [id])
  status            ApprovalStatus @default(PENDING)
  reason            String?
  decidedByUserId   String?
  decidedBy         User?          @relation("ApprovalDecidedBy", fields: [decidedByUserId], references: [id])
  decidedAt         DateTime?
  decisionNotes     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
}
